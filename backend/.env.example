DATABASE_URL="postgresql://ecp_user:ecp_pass@localhost:5432/elcampito_play?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
# Con Upstash (u otro Redis "cloud" con TLS): REDIS_HOST=<tu-endpoint>.upstash.io,
# REDIS_PASSWORD=<password>, REDIS_TLS=true
# REDIS_PASSWORD=
# REDIS_TLS=false

JWT_ACCESS_SECRET=dev-access-secret-change-me-in-prod
VIDEO_URL_SIGNING_SECRET=dev-video-signing-secret-change-me

STORAGE_PROVIDER=LOCAL
LOCAL_STORAGE_ROOT=../storage-data
API_PUBLIC_URL=http://localhost:3001
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

PORT=3001

# --- Config para produccion con S3/MinIO (no usado en esta demo) ---
# STORAGE_PROVIDER=S3
# S3_BUCKET=elcampito-play
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# --- Camaras cloud via Imou Open Platform (para camaras Dahua/Imou wifi sin RTSP directo) ---
# appId/appSecret: Consola de developer en open.imoulife.com -> My App -> App Information.
# IMOU_DATA_CENTER: el data center de tu cuenta (se ve en Consola -> My Information).
#   sg = East Asia . fk = Central Europe . or = Western America
# IMOU_APP_ID=
# IMOU_APP_SECRET=
# IMOU_DATA_CENTER=sg

# --- Pago por ver videos (Mercado Pago, modelo marketplace — cada complejo conecta su propia
# cuenta, la plata le entra directo a él; ver backend/src/payments/mercadopago.service.ts) ---
# MP_CLIENT_ID/MP_CLIENT_SECRET: de la aplicación de Mercado Pago creada a nombre de LivePlay
# (panel de desarrolladores de Mercado Pago -> "Tus integraciones" -> crear aplicación). NO son
# credenciales de ningún complejo en particular, son las de LivePlay como marketplace.
# MP_CLIENT_ID=
# MP_CLIENT_SECRET=
# % de comisión que se queda LivePlay sobre cada pase vendido (ej. 10 = 10%). Default 0 (sin
# comisión) si no se define.
# MP_MARKETPLACE_FEE_PERCENT=10

# --- Config de email real (si no se define ninguna, los emails se loguean por consola) ---
# Resend via su API HTTP (recomendado - SMTP saliente lo bloquean varios hosting como Render):
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=LivePlay <onboarding@resend.dev>
#
# Alternativa via SMTP normal (otros proveedores sin API HTTP propia):
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASS=xxxx
