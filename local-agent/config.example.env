# --------------------------------------------------------------
# Configuracion del agente local de LivePlay (ver ../backend/AGENTE.md)
# --------------------------------------------------------------
# Copia este archivo a "config.env" (sin el .example) y completa los valores reales.
# config.env NO se sube a git (ver .gitignore) porque tiene el token de la camara.

# URL base del backend de LivePlay (sin /api al final si tu backend lo sirve en la raiz;
# en produccion es la de Render).
LIVEPLAY_API_BASE=https://liveplay-fuh6.onrender.com/api

# Token de esta camara. Se genera UNA vez desde el panel de admin (o llamando a mano
# POST /cameras/:id/agent-token con tu sesion de SUPER_ADMIN/COMPLEX_ADMIN) y se muestra
# en texto plano una sola vez - copialo aca y no lo pierdas, no se puede volver a ver.
AGENT_KEY=PEGAR_ACA_EL_TOKEN_DE_LA_CAMARA

# URL RTSP de la camara de ESTA cancha (la misma que se cargo en /admin/canchas al crear
# la camara tipo RTSP/IP/NVR/DVR). Para Imou Cloud este agente no aplica: esas camaras no
# exponen RTSP, solo HLS en vivo - ver la conversacion del 2026-09-14 en el resumen del proyecto.
RTSP_URL=rtsp://usuario:clave@192.168.1.50:554/stream1

# Duracion de cada segmento grabado, en segundos. 300 (5 min) es un buen default: bastante
# chico para no perder mucho si el proceso se corta, bastante grande para no generar
# miles de archivos por dia.
SEGMENT_SECONDS=300

# Cuantas horas se guardan los segmentos crudos en el dispositivo antes de borrarlos.
# Tiene que ser bastante mas que la duracion tipica de un turno + el margen de subida.
RETENTION_HOURS=8

# Cada cuantos segundos el agente pregunta al backend "Â¿que partidos de mi cancha estan
# terminados y sin video?".
POLL_SECONDS=120

# Minutos de margen despues del horario de fin de un turno para asumir que termino, en el
# caso (mas comun) de que el partido no tenga endTime cargado a mano. Ajustalo a la duracion
# real de un turno en esta cancha.
BUFFER_MINUTES=15

# Carpetas de trabajo del agente en el dispositivo (Termux, Raspberry, etc.)
RECORDINGS_DIR=$HOME/liveplay-agent/recordings
TMP_DIR=$HOME/liveplay-agent/tmp
LOG_DIR=$HOME/liveplay-agent/logs
