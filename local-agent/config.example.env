# ──────────────────────────────────────────────────────────────
# Configuración del agente local de LivePlay (ver ../backend/AGENTE.md)
# ──────────────────────────────────────────────────────────────
# Copiá este archivo a "config.env" (sin el .example) y completá los valores reales.
# config.env NO se sube a git (ver .gitignore) porque tiene el token de la cámara.

# URL base del backend de LivePlay (sin /api al final si tu backend lo sirve en la raíz;
# en producción es la de Render).
LIVEPLAY_API_BASE=https://liveplay-fuh6.onrender.com/api

# Token de esta cámara. Se genera UNA vez desde el panel de admin (o llamando a mano
# POST /cameras/:id/agent-token con tu sesión de SUPER_ADMIN/COMPLEX_ADMIN) y se muestra
# en texto plano una sola vez — cópialo acá y no lo pierdas, no se puede volver a ver.
AGENT_KEY=PEGAR_ACA_EL_TOKEN_DE_LA_CAMARA

# URL RTSP de la cámara de ESTA cancha (la misma que se cargó en /admin/canchas al crear
# la cámara tipo RTSP/IP/NVR/DVR). Para Imou Cloud este agente no aplica: esas cámaras no
# exponen RTSP, solo HLS en vivo — ver la conversación del 2026-09-14 en el resumen del proyecto.
# Si la cámara (aunque sea Dahua/Imou) está en la MISMA red que este dispositivo, no hace
# falta pasar por Imou Cloud: se puede traer el video directo por RTSP. Formato típico de
# Dahua: rtsp://usuario:clave@IP:554/cam/realmonitor?channel=N&subtype=0 (subtype=0 = stream
# principal/mejor calidad, subtype=1 = substream liviano; channel = número de cámara, 1 si es
# standalone o el puerto correspondiente si sale de un NVR) — ver backend/AGENTE.md.
# IMPORTANTE: siempre entre comillas dobles. Toda URL de Dahua lleva un "&" en la query string
# (channel=N&subtype=0) y sin comillas bash lo interpreta como "correr en segundo plano": la
# variable queda vacía silenciosamente al hacer `source` de este archivo (bug real encontrado
# el 2026-09-18/19 instalando en "Padel Club Tapalqué" — ver el resumen del proyecto).
RTSP_URL="rtsp://admin:clave@192.168.1.50:554/cam/realmonitor?channel=1&subtype=0"

# Duración de cada segmento grabado, en segundos. 300 (5 min) es un buen default: bastante
# chico para no perder mucho si el proceso se corta, bastante grande para no generar
# miles de archivos por día.
SEGMENT_SECONDS=300

# Cuántas horas se guardan los segmentos crudos en el dispositivo antes de borrarlos.
# Tiene que ser bastante más que la duración típica de un turno + el margen de subida.
RETENTION_HOURS=8

# Cada cuántos segundos el agente pregunta al backend "¿qué partidos de mi cancha están
# terminados y sin video?".
POLL_SECONDS=120

# Minutos de margen después del horario de fin de un turno para asumir que terminó, en el
# caso (más común) de que el partido no tenga endTime cargado a mano. Ajustalo a la duración
# real de un turno en esta cancha.
BUFFER_MINUTES=15

# OPCIONAL — cada cuántos segundos watchdog.sh revisa que record.sh/ffmpeg/uploader.py sigan
# vivos y los relanza solo si alguno se murió sin que nadie lo note (agregado el 2026-10-04,
# ver el comentario largo en watchdog.sh). 180s (3 min) es un buen default; no hace falta
# tocarlo salvo que quieras un chequeo más o menos seguido.
WATCHDOG_INTERVAL_SECONDS=180

# Carpetas de trabajo del agente en el dispositivo (Termux, Raspberry, etc.)
RECORDINGS_DIR=$HOME/liveplay-agent/recordings
TMP_DIR=$HOME/liveplay-agent/tmp
LOG_DIR=$HOME/liveplay-agent/logs

# OPCIONAL — respaldo en una SD card (solo Termux/Android). Si el dispositivo tiene una
# microSD insertada y le diste acceso con `termux-saf-managedir` (ver backend/AGENTE.md),
# pegá acá la URI de la carpeta donde querés que el agente guarde una copia de cada video
# YA subido con éxito al servidor (no la grabación cruda, solo el clip final de cada
# partido) — así si el TV box se rompe o hay que reinstalarlo, el video del partido no se
# pierde aunque el servidor no lo tenga por algún motivo. Se consigue esa URI así:
#   termux-saf-mkdir "<uri-de-la-carpeta-raíz-de-termux-saf-dirs>" "liveplay-respaldos"
# (te devuelve la URI de la carpeta nueva, es la que va acá abajo). Si dejás esto vacío,
# el agente sigue funcionando igual, simplemente no hace respaldo a SD.
SAF_BACKUP_DIR_URI=
